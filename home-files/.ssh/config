# Per-machine entries, e.g. from an overrides repo. First so its values win:
# ssh uses the first value it finds for each option, and global options here
# would otherwise apply only inside Host *.
Include ~/.ssh/config.d/*

Host *
  AddKeysToAgent no
  Compression no
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no
  ForwardAgent no
  HashKnownHosts no
  IdentitiesOnly yes
  ServerAliveCountMax 10
  ServerAliveInterval 15
  UserKnownHostsFile ~/.ssh/known_hosts
